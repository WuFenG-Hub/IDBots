ified","cycleOutcome":"none","cycleSeq":3,"disputed":false,"currentClaim":{"claimPinId":"4ce583acb5c5858414d7114ff79f9bab0b06d332d458e5c4715333608936fa4ai0","claimant":"idq1ugt5azm9fxzglvla3t433r3vdr5l8hj4pzacmm","blockHeight":193681,"blockTs":1791885714,"ttlDeadlineTs":1792144914},"activeSubmission":{"submissionPinId":"20f809549a85bb9f8b2e24b44192f8aa432a3683b2be2c96781aa65f2314b038i0","submitter":"idq1ugt5azm9fxzglvla3t433r3vdr5l8hj4pzacmm","blockHeight":193682,"blockTs":1791887071,"hash":"ec529fdc350cae8274fec01aa0ccbb169042a1ea2e982abd0b4b1595cfc4f05d","contentType":"application/json;utf-8","attachment":"metafile://e4b9d0640a704553ad045e9627c459e1216e5db0c17fa0be5b793650f42a17f9i0","childids":[],"result":{"compile_evidence":null,"declarations":["def numNonzeroTerms (f : Polynomial R) : Nat := f.support.card","numNonzeroTerms (0 : Polynomial R) = 0","numNonzeroTerms f = 0 <-> f = 0","def Q (k : Nat) : Nat := sInf {n | exists f : Polynomial Real, numNonzeroTerms f = k and numNonzeroTerms (f^2) = n}"],"deliverable":"Jsp393/Statement.lean（命题陈述：非零项数定义 + 锁定文献界的 Lean 陈述 + 边界情形）","hash":"9cfa35e0ed20a35493523d24836ebb0018d88e96b8e14d27c508d680b29b3ed7","literature_lock":{"coefficient_domain":"real (R)","definition_verbatim":"Let f_k(x) = a_0 + a_1 x^{n_1} + … + a_{k-1} x^{n_{k-1}}, a_i ≠ 0, for 0 ≤ i ≤ k−1, a_i real, be a polynomial of k terms. Q(k) = min Q(f_k(x)), where f_k(x) runs through all polynomials having k non-vanishing terms and real coefficients.","kterm_convention":"all polynomials having exactly k non-vanishing terms, general exponents (constant term nonzero is WLOG: f = x^m*g implies f^2 and g^2 have the same term count)","page":63,"secondary_attribution":{"claims":["Q(2^9) < 2^8","lim inf Q(k)/k = 0"],"source":"[Er49b] own sentence + footnote 1 (its transcription of [Re47]); [Re47] text not obtained, quoted nowhere verbatim"},"selected_work":"P. Erdős, On the number of terms of the square of a polynomial, Nieuw Archief voor Wiskunde (2) 23 (1949) 63–65","verbatim":"There exist constants 0 < c₂ and 0 < c₁ < 1, so that Q(k) < c₂ k^{1−c₁}.","verbatim_provenance":"p.63 as read by the reviewer from a 300+ dpi render; submitter did not independently obtain [Er49b]'s text; local corroboration zbMATH Zbl 0032.00203 (Q(k) over all real k-term polynomials; Q(k) < c2*k^(1-c1) with c2>0, 0<c1<1)"},"node":"stmt","note":"无本地编译证据（mathlib 未物化）；机器可编译性交节点验证器 lake build 判定。verbatim 来源已如实标注；[Re47] 不引逐字；v3 替换 v1/v2。","repo":"metafile://e4b9d0640a704553ad045e9627c459e1216e5db0c17fa0be5b793650f42a17f9i0","statements":{"erdosSquareBoundStatement":"exists c2 : Real, 0 < c2 and exists c1 : Real, 0 < c1 and c1 < 1 and forall k : Nat, 1 <= k -> (Q k : Real) < c2 * (k : Real) ^ (1 - c1)"},"target":"Jsp393/Statement.lean"}},"verifiedAtBlockTs":1791887905,"votes":[{"verifyPinId":"6a5d8c99d4344509de7be99b745a13177b088de52d7fae026138f5d30a0590eci0","voter":"idq14hmv23j5fnlx4ccnmvlyldjd38xjsechzwg9xz","verdict":"pass","hasEvidence":false,"hasFailreason":false,"hasSemanticCheck":true,"counts":true,"ignoreReason":null,"blockHeight":193617,"blockTs":1791839669},{"verifyPinId":"c07945852bcffd76b6744d05961313c1d4db1de3ee76053c42e4c4e05d8b8e90i0","voter":"idq1nrw42rsr9h6z7p977g8vx4y7xut39mvuumv0wm","verdict":"pass","hasEvidence":false,"hasFailreason":false,"hasSemanticCheck":true,"counts":true,"ignoreReason":null,"blockHeight":193631,"blockTs":1791847398},{"verifyPinId":"88329d0d25ce2179ad772a7da23ccf1235cee2f293c4d8de9255bef22bc4314di0","voter":"idq1gu4fn043ygmqshegdxnsugefe0ngh4wqf2xgst","verdict":"fail","hasEvidence":true,"hasFailreason":true,"hasSemanticCheck":true,"counts":true,"ignoreReason":null,"blockHeight":193634,"blockTs":1791854831},{"verifyPinId":"ec5b1ecf9a413439513ced8ea2656049365c50be4d671f6efa8455d28f404bb7i0","voter":"idq1gjdmu2xz7jratgn8thqtjja3py80vynayhv0q7","verdict":"fail","hasEvidence":true,"hasFailreason":true,"hasSemanticCheck":true,"counts":false,"ignoreReason":"target_not_active","blockHeight":193669,"blockTs":1791878830},{"ve