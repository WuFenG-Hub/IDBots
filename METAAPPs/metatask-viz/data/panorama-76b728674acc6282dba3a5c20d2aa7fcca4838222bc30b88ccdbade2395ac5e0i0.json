{"rootPinId":"76b728674acc6282dba3a5c20d2aa7fcca4838222bc30b88ccdbade2395ac5e0i0","title":"IDBots 技能健康度 · 腐坏检测器与公开样本实证（公开数据 · 5 节点）","brief":"针对「技能从链上装到本地之后会不会腐坏」这一 IDBots 产品共有问题：以链上公开技能包为对象、以 IDBots 开源仓库（github.com/metaid-developers/IDBots, MIT）为背景资料，交付四类腐坏信号的分类口径、公开样本采集、可复现腐坏固件、与机器无关的检测器，以及在公开样本上的对照实验与终检。所有结论须可复跑、负结果照实报。机制基线见《IDBots 技能机制说明（公开版·基于真实源码）v2》。","publisher":"idq14hmv23j5fnlx4ccnmvlyldjd38xjsechzwg9xz","tags":["RSI","skill-drift","IDBots","reproducibility","MetaWeb"],"treeid":"299842dc6fd96fe337d68924f6a77cd10b93e3ad7e739f67a1cd4952056398b4i0","specid":"f3308189d884c4d7452c41cead811474fc7df1c4f1b361584b2175296fa19d98i0","spec":{"name":"skill-drift-root","lang":"python3","entry":"spec-drift-root.py","scriptOrScriptPin":"#!/usr/bin/env python3\n\"\"\"spec-drift-root.py — N0a (腐坏分类与口径) verifier.\n\nMetaTask v1.3 competitive-mode verifier (protocol draft section 4.3 CI-style contract).\n\nArtifact contract: metafile bundle: scope.md + schema.json + seed-records.json (>=10 公开包种子，无重复)\n\nEnvironment: METATASK_ARTIFACT_URI / METATASK_NODE / METATASK_TASKID /\n  METATASK_DOWNLOAD_BASE (metafile resolution: <base>/file/<urlencoded URI>) /\n  METATASK_RESOLVE=0 disables live link resolution (offline dry runs);\n  METATASK_INSECURE=1 allows an unverified TLS context when no CA store exists.\n\nExit codes: 0 pass (evidence on stdout) / 1 fail (reason on stderr) /\n2 invalid (null / empty / unresolvable input). The pass path asserts the\nenumeration closure: the check counter must equal EXPECTED_CHECKS.\n\"\"\"\n\nEXPECTED_CHECKS = 8\n\nimport io\nimport json\nimport os\nimport re\nimport sys\nimport tarfile\nimport urllib.error\nimport urllib.parse\nimport urllib.request\nimport zipfile\n\n\nchecks_done = 0\n\n\ndef ok(msg):\n    global checks_done\n    checks_done += 1\n    print(\"OK   \" + msg)\n\n\ndef emit(verdict, detail):\n    print(json.dumps({\"verdict\": verdict, \"detail\": detail, \"checks\": checks_done}, ensure_ascii=False))\n\n\ndef closure():\n    \"\"\"Assert the enumeration closure without consuming a check slot.\"\"\"\n    if checks_done != EXPECTED_CHECKS:\n        die_fail(\"enumeration closure: %d/%d checks\" % (checks_done, EXPECTED_CHECKS))\n    print(\"OK   enumeration closure: %d/%d checks\" % (checks_done, EXPECTED_CHECKS))\n\n\ndef die_fail(msg):\n    emit(\"fail\", msg)\n    print(\"FAIL: \" + msg, file=sys.stderr)\n    sys.exit(1)\n\n\ndef die_invalid(msg):\n    emit(\"invalid\", msg)\n    sys.exit(2)\n\n\ndef check(cond, msg):\n    if not cond:\n        die_fail(msg)\n    ok(msg)\n\n\ndef _guard(exc_type, exc, tb):\n    \"\"\"Any unhandled error is INVALID input, never a fail verdict.\"\"\"\n    if issubclass(exc_type, SystemExit):\n        return\n    emit(\"invalid\", \"unhandled %s: %s\" % (exc_type.__name__, exc))\n    sys.exit(2)\n\n\nsys.excepthook = _guard\n\n\ndef ssl_context():\n    \"\"\"CA bundle for HTTPS: certifi when available; METATASK_INSECURE=1 opts out.\n\n    The host Python on some macOS installs ships without the system CA store, so\n    a bare urlopen fails SSL verification while curl succeeds. Reviewers get a\n    documented opt-out, and every use is logged as reduced evidence.\n    \"\"\"\n    import ssl\n    try:\n        import certifi\n        ctx = ssl.create_default_context(cafile=certifi.where())\n    except Exception:  # noqa: BLE001\n        ctx = ssl.create_default_context()\n    if os.environ.get(\"METATASK_INSECURE\") == \"1\":\n        print(\"NOTE ssl verification disabled (METATASK_INSECURE=1) — resolution evidence is weaker\")\n        ctx.check_hostname = False\n        ctx.verify_mode = ssl.CERT_NONE\n    return ctx\n\n\ndef artifact_uri():\n    uri = os.environ.get(\"METATASK_ARTIFACT_URI\", \"\").strip()\n    if not uri:\n        die_invalid(\"METATASK_ARTIFACT_URI is empty\")\n    return uri\n\n\ndef fetch_bytes(uri):\n    if uri.startswith((\"metafile://\", \"pin://\")):\n        base = os.environ.get(\"METATASK_DOWNLOAD_BASE\", \"\").strip()\n        if not base:\n            die_invalid(\"METATASK_DOWNLOAD_BASE unset — cannot resolve \" + uri)\n        url = base.rstrip(\"/\") + \"/file/\" + urllib.parse.quote(uri, safe=\"\")\n        path = None\n    elif uri.startswith(\"file://\"):\n        url, path = None, uri[7:]\n    else:\n        url, path = None, uri\n    try:\n        if url:\n            req = urllib.request.Request(url, headers={\"User-Agent\": \"metatask-spec/1.0\"})\n            with urllib.request.urlopen(req, timeout=60, context=ssl_context()) as resp:\n                return resp.read()\n        with open(path, \"rb\") as fh:\n            return fh.read()\n    except Exception as exc:  # noqa: BLE001 - any fetch failure is an invalid run\n        die_invalid(\"artifact fetch failed for %s: %r\" % (uri, exc))\n\n\ndef load_members(data):\n    \"\"\"Return {name: bytes} for an archive, or {\"__raw__\": decoded text}.\"\"\"\n    if data[:2] != b\"\\x1f\\x8b\" and data[:2] != b\"PK\":\n        return {\"__raw__\": data.decode(\"utf-8\", \"replace\")}\n\n    members = {}\n    if data[:2] == b\"PK\":\n        with zipfile.ZipFile(io.BytesIO(data)) as arc:\n            names = [n for n in arc.namelist() if not n.endswith(\"/\")]\n            for name in names:\n                members[name] = arc.read(name)\n    else:\n        with tarfile.open(fileobj=io.BytesIO(data), mode=\"r:gz\") as arc:\n            names = [n for n in arc.getnames() if not n.endswith(\"/\")]\n            for name in names:\n                handle = arc.extractfile(name)\n                if handle is not None:\n                    members[name] = handle.read()\n\n    if not members:\n        die_invalid(\"artifact archive is empty — nothing to verify\")\n\n    # 仅在「所有成员共享同一个顶层目录、且该目录不是契约要求的目录名」时剥离。\n    # 契约里的 experiment/ 与 repro/ 是语义目录，绝不能当作包装目录剥掉。\n    RESERVED = {\"experiment\", \"repro\", \"fixtures\"}\n    if members and all(\"/\" in n for n in members):\n        tops = {n.split(\"/\")[0] for n in members}\n        if len(tops) == 1:\n            top = sorted(tops)[0]\n            if top not in RESERVED:\n                members = {n[len(top) + 1:]: v for n, v in members.items()}\n    return members\n\n\ndef text_of(members, name):\n    if name in members:\n        return members[name].decode(\"utf-8\", \"replace\")\n    raw = members.get(\"__raw__\")\n    if raw is not None and name.endswith(\".md\"):\n        return raw\n    return None\n\n\ndef as_text(value):\n    if isinstance(value, (bytes, bytearray)):\n        return value.decode(\"utf-8\", \"replace\")\n    return value\n\n\ndef json_of(members, name):\n    for key in (name, \"__raw__\"):\n        if key not in members:\n            continue\n        text = as_text(members[key])\n        if not isinstance(text, str):\n            return None\n        try:\n            return json.loads(text)\n        except Exception:  # noqa: BLE001\n            if key == name:\n                die_fail(\"%s is present but is not valid JSON\" % name)\n            return None\n    return None\n\n\nMETA_BLOCK_RE = re.compile(r\"<!--\\\\s*meta:.*?-->\", re.S)\n\n\ndef body_only(doc):\n    \"\"\"The document without its machine-readable meta declarations.\n\n    Declarations must never satisfy a check about the document body: strip them\n    first, or a document that declares 50 citations and writes nothing passes.\n    \"\"\"\n    return META_BLOCK_RE.sub(\"\", doc)\n\n\ndef raw_list(value):\n    if value is None:\n        return []\n    return [x.strip() for x in value.split(\",\") if x.strip()]\n\n\ndef resolve_ratio(urls):\n    \"\"\"Live-resolve links. Returns (good, total) or None when disabled.\"\"\"\n    if os.environ.get(\"METATASK_RESOLVE\", \"1\") == \"0\":\n        return None\n    good = 0\n    for url in urls:\n        try:\n            req = urllib.request.Request(url, headers={\"User-Agent\": \"Mozilla/5.0 (metatask-spec)\"})\n            with urllib.request.urlopen(req, timeout=20, context=ssl_context()) as resp:\n                if resp.status == 200:\n                    good += 1\n        except urllib.error.HTTPError as exc:\n            if exc.code >= 500:\n                die_invalid(\"server error %s while resolving %s\" % (exc.code, url))\n        except Exception as exc:  # noqa: BLE001\n            die_invalid(\"network unavailable while resolving links: %r\" % exc)\n    return good, len(urls)\n\n\ndef meta_block(doc, key):\n    \"\"\"Read <!-- meta: key=value --> from a document.\"\"\"\n    hit = re.search(r\"<!--\\\\s*meta:\\\\s*\" + key + r\"=([^>]*?)-->\", doc)\n    return hit.group(1).strip() if hit else None\n\n\ndef id_list(value):\n    if value is None:\n        return None\n    return sorted(x.strip() for x in value.split(\",\") if x.strip())\n\n# --- N0a: 腐坏分类与口径（scope.md + schema.json + seed-records.json）-------------\n\nSIGNALS = (\"S1\", \"S2\", \"S3\", \"S4\")\nFIELDS = (\"skill_id\", \"source_pin\", \"bundle_hash\", \"signal_values\",\n          \"evidence_path\", \"captured_at\", \"machine_id\")\n\nARTIFACT = artifact_uri()\nmembers = load_members(fetch_bytes(ARTIFACT))\nscope = text_of(members, \"scope.md\")\nschema = json_of(members, \"schema.json\")\nseed = json_of(members, \"seed-records.json\")\ncheck(scope is not None and isinstance(schema, dict) and isinstance(seed, list),\n      \"bundle carries scope.md + schema.json + seed-records.json (array)\")\n\nmissing_signals = [s for s in SIGNALS if s not in (scope or \"\")]\ncheck(not missing_signals,\n      \"scope.md declares all four rot signals S1..S4 (missing: %s)\" % (missing_signals or \"none\"))\n\nschema_fields = set(schema.get(\"fields\") or [])\nabsent = [f for f in FIELDS if f not in schema_fields]\ncheck(not absent, \"schema.json lists all 7 field names (absent: %s)\" % (absent or \"none\"))\n\ndoc_ref = schema.get(\"mechanics_doc_ref\") or \"\"\ncheck(bool(doc_ref) and (\"mechanics\" in doc_ref.lower() or \"机制\" in doc_ref),\n      \"schema declares its alignment to the public mechanics note (mechanics_doc_ref present)\")\n\nexcl = scope or \"\"\ncheck((\"排除\" in excl) or (\"exclusion\" in excl.lower()),\n      \"scope.md carries an explicit exclusion rule section\")\n\ncheck(len(seed) >= 10, \"seed-records.json holds >= 10 public-package records (got %d)\" % len(seed))\n\nseed_ids = [str(r.get(\"skill_id\", \"\")) for r in seed]\ncheck(len(seed_ids) == len(set(seed_ids)),\n      \"seed skill_ids are unique (%d rows / %d distinct)\" % (len(seed_ids), len(set(seed_ids))))\n\nseed_missing = [r.get(\"skill_id\", \"?\") for r in seed\n                if not all(str(r.get(f, \"\")).strip() for f in FIELDS)]\ncheck(not seed_missing,\n      \"every seed record carries all 7 schema fields (missing on: %s)\" % (seed_missing or \"none\"))\n\nclosure()\nemit(\"pass\", \"scope + schema + %d seed records verified\" % len(seed))\n","input":"","output":""},"policy":{"challenge_ttl_days":14,"claim_ttl_hours":0,"finalnode":"N5","mode":"competitive","reward_sat":0,"split":{"rosterid":"b4c913291b254fe9fdfb7931f650af6ab3a8b3de05fe836dcb276588cd2d01f5i0","submitterShareBP":8000},"verify_quorum":2,"verify_window_hours":0},"nodes":[{"id":"N2","parent":"N3","title":"检测器 · 与机器无关的技能健康度工具","kind":"formalize","params":{"rubric":["交付可安装检测工具：输入任意技能目录，输出四类信号报告（JSON + 人类可读）","**检测器必须实现干跑模式，且包内真实存在可执行入口**（机检：入口文件在场 + 含干跑开关）","对 N1b 全部固件逐一运行，须全部报红且理由精确（固件与预期成对）","**四类信号取值不得为空白**（机检：每条记录的信号值非空）","在 >= 30 个真实公开包上跑通并附报告","预算：单次全量检测 <= 5 分钟，<= 5k token"]},"specid":"c8d6c4c312b13a464b25fc330c7795da807e9975c36560996194d48ed6a0ffeci0","deps":["N1a","N1b"],"weight":2300,"machineState":"open","displayState":"open","cycleOutcome":"none","cycleSeq":0,"disputed":false,"currentClaim":null,"activeSubmission":null,"verifiedAtBlockTs":null,"votes":[{"verifyPinId":"4f818c4574176514712426d42bfda4d2eb55b50f9abb634c1d56cf36d34a9913i0","voter":"idq14nyxgcqx6f26zpn68xmvrg0xe87fdevl0n4t5k","verdict":"pass","hasEvidence":true,"hasFailreason":false,"hasSemanticCheck":true,"counts":false,"ignoreReason":"duplicate_vote