{
  "appId": "world.idbots.app",
  "appName": "IDBots",
  "webDir": "www",
  "server": {
    "url": "https://staging.idbots.world/",
    "errorPath": "offline.html?retry=https%3A%2F%2Fstaging.idbots.world%2F",
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": [
      "staging.idbots.world"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "loggingBehavior": "none"
  },
  "ios": {
    "contentInset": "never",
    "loggingBehavior": "none"
  },
  "backgroundColor": "#F5F7F9"
}
