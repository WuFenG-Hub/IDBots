# WS-C — host-level deploy variables (NO SECRETS IN THIS FILE).
# Copy to /etc/idbots/deploy.env (root:root, 0644) and fill in.
# Consumed by: docker compose --env-file /etc/idbots/deploy.env, and by
# bootstrap.sh when rendering prometheus.yml.

# Public host name Caddy serves. app.{APP_DOMAIN} on production,
# staging.{APP_DOMAIN} on staging.
APP_HOST=app.example.com

# Alibaba Cloud Container Registry endpoint (Hong Kong).
REGISTRY=registry.cn-hongkong.aliyuncs.com

# Control-plane image tag to run ({version}-{commit7}, built by CI).
CP_IMAGE_TAG=0.0.0-0000000

# Set by bootstrap.sh for prometheus.yml templating: staging or production.
ENV_ROLE=staging
