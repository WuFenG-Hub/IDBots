# WS-C — monitoring/alerting configuration.
# Copy to /etc/idbots/monitoring.env (root:root, 0600). NEVER commit the filled file.

# Feishu or DingTalk custom-robot webhook URL. The relay auto-detects the
# platform from the URL (override with ALERT_TARGET=feishu|dingtalk).
ALERT_WEBHOOK_URL=REPLACE_ME_feishu_or_dingtalk_webhook_url

# Optional robot signing secret ("加签"). Leave empty if the robot uses
# keyword-only protection — every relayed message carries the [IDBots] prefix,
# so set [IDBots] as the robot keyword in that case.
ALERT_SECRET=
