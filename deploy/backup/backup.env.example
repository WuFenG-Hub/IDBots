# WS-C REQ-C-14 — backup configuration.
# Copy to /etc/idbots/backup.env (root:root, 0600). NEVER commit the filled file.

# --- destination -------------------------------------------------------------
# oss = Alibaba Cloud OSS Hong Kong bucket (production). local = write objects
# under BACKUP_LOCAL_DIR instead (restore drills and development only).
BACKUP_BACKEND=oss

# OSS bucket + endpoint (Hong Kong). Bucket is created once by
# oss-bucket-setup.sh (SSE, versioning, 30-day lifecycle).
OSS_BUCKET=REPLACE_ME_bucket_name
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com

# RAM user with OSS write on THIS bucket only (least privilege; never root).
OSS_ACCESS_KEY_ID=REPLACE_ME_ram_oss_write_access_key_id
OSS_ACCESS_KEY_SECRET=REPLACE_ME_ram_oss_write_access_key_secret

# Local drill destination (BACKUP_BACKEND=local only).
BACKUP_LOCAL_DIR=/var/lib/idbots/backup-drill

# --- encryption ----------------------------------------------------------------
# age public key: every archive is encrypted client-side before upload.
# The matching private key stays OFFLINE with the owner (restore drills bring
# it in as BACKUP_AGE_KEY_FILE, mode 0600, and remove it afterwards).
# Generate a key pair on an operator machine: age-keygen -o idbots-backup.key
BACKUP_AGE_RECIPIENT=REPLACE_ME_age1...

# --- schedule / behavior ---------------------------------------------------------
# Nightly window 03:00-05:00 Asia/Shanghai; max seconds a tenant container may
# stay paused (REQ-C-14: at most 60 s).
BACKUP_PAUSE_BUDGET_SECONDS=60
# Max pause between two tenant backups while staggering (computed per run).
BACKUP_STAGGER_MAX_SECONDS=300

# --- alerts ------------------------------------------------------------------------
# Feishu or DingTalk robot webhook. A failed backup raises an alert (REQ-C-14).
BACKUP_ALERT_WEBHOOK=REPLACE_ME_feishu_or_dingtalk_webhook_url

# --- metrics -------------------------------------------------------------------------
# node-exporter textfile collector directory (bootstrap.sh creates it).
BACKUP_TEXTFILE_DIR=/var/lib/idbots/node-exporter-textfile

# --- overrides (normally unchanged) ----------------------------------------------------
# Control-plane volume and container names (compose project "idbots").
CP_VOLUME_NAME=idbots_cp-data
CP_CONTAINER_NAME=idbots-control-plane-1
# Object retention is enforced by the bucket lifecycle rule (30 days), see
# oss-lifecycle.json. Objects: tenants/{tenantId}/{yyyy-mm-dd}.tar.zst.enc and
# control-plane/{yyyy-mm-dd}.sqlite.zst.enc
